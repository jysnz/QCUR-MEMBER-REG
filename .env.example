# Copy this file to .env for local use. On Vercel, add the same names under Project Settings > Environment Variables.
# Never commit .env or share the secret values.

# --- Supabase ---
SUPABASE_URL=https://szbtmeyoctkscwjcdrvg.supabase.co
# Project Settings > API Keys > "Legacy API keys" tab > service_role (a long key starting with eyJ). Server only.
# It must be the legacy JWT key, because the verify-turnstile edge function checks the caller's JWT.
SUPABASE_SERVICE_ROLE_KEY=

# --- Human check (Cloudflare Turnstile) ---
# The SITE key is public by design and is shown in the page.
TURNSTILE_SITE_KEY=0x4AAAAAAF-IwARWa-tyl-Uo
# The SECRET key does NOT go here. It is stored in Supabase: Edge Functions > Secrets > TURNSTILE_SECRET_KEY.
# (Only set TURNSTILE_SECRET_KEY here if you want to skip the edge function and verify with Cloudflare directly.)

# --- Members page protection (strongly recommended) ---
ADMIN_KEY=
